#!/usr/bin/env python3
"""tb-guide — a terminal breathing guide for Terminal Breather.

Runs a breathing session right in the terminal (for use over SSH, e.g.
Termius on a phone, where the GUI overlay on the computer's displays is not
visible). Same patterns and timings as the aven.terminal-breather plugin.

The guide draws a circle that grows as you breathe in, holds, and
shrinks as you breathe out — the same idea as the overlay's figure that
scales with the breath — with a colour that shifts by phase.

Sessions that reach at least one minute are logged exactly the way the
overlay logs them: minutes added to today's entry in
~/.local/state/omarchy/aven.terminal-breather/stats.json, and, unless
meditationLogEnabled is false in shell.json, one row appended to the
meditation log (the vault default, or meditationLogPath from shell.json when
set). Ending early still logs the minutes actually practiced. Sessions under a
minute are not logged.

The stats file is Breather's own; omarchy-zen keeps its separate
~/.local/state/omarchy/zen/stats.json. On the first run, when Breather's file
does not exist yet, it is created from a copy of Zen's file so existing
totals carry over once; Zen's file is only read, and never again after that
(see seed_stats). The overlay, the bar and this guide all write Breather's
file, so every write re-reads it under a lock, adds the minutes, and replaces
the file atomically (see add_stats_minutes). `tb-guide --record-stats` is the
stats-only write the overlay uses for the same merge, and `tb-guide --seed-stats`
the first-run copy the bar and overlay run when they load.

Usage: tb-guide [pattern] [minutes]
       tb-guide --record-stats PATH YYYY-MM-DD MINUTES [SEED]
       tb-guide --seed-stats PATH SEED
  pattern  box (default), 478, coherent, or a custom key from
           ~/.config/omarchy/zen/patterns.json
  minutes  session length (default 5, max 120)

Ctrl+C ends the session early.
"""

import fcntl
import json
import math
import os
import re
import shutil
import signal
import stat
import sys
import tempfile
import time
from datetime import datetime

# Built-in patterns, mirroring ZenModel.js PATTERNS.
# Each phase: (label, seconds, fullness at end) — fullness 0 = exhaled,
# 1 = inhaled. The circle grows toward 1 on inhale and shrinks toward 0
# on exhale; a hold keeps the current fullness.
BUILTIN = {
    "box": {
        "name": "Box breathing",
        "phases": [
            ("Breathe in", 4, 1),
            ("Hold", 4, 1),
            ("Breathe out", 4, 0),
            ("Hold", 4, 0),
        ],
    },
    "478": {
        "name": "4-7-8",
        "phases": [
            ("Breathe in", 4, 1),
            ("Hold", 7, 1),
            ("Breathe out", 8, 0),
        ],
    },
    "coherent": {
        "name": "Coherent",
        "phases": [
            ("Breathe in", 5.5, 1),
            ("Breathe out", 5.5, 0),
        ],
    },
}

# ANSI colours per phase (by the first word of the label).
PHASE_COLOURS = {
    "Breathe in": "36",   # cyan
    "Hold": "33",         # amber
    "Breathe out": "35",  # magenta
}
RESET = "\x1b[0m"

# Terminal characters are about twice as tall as they are wide, so a
# circle drawn in character cells needs the x axis stretched.
ASPECT = 2.0
MIN_RADIUS = 1.5

# ---- Session logging, mirroring ZenModel.js / BreatheOverlay.qml ----
# Stats are stored as {"days": {"2026-08-22": 10, ...}} minutes.
STATS_PATH = os.path.expanduser("~/.local/state/omarchy/aven.terminal-breather/stats.json")
# omarchy-zen's stats file: the one-time seed for STATS_PATH, read only (see seed_stats).
ZEN_STATS_PATH = os.path.expanduser("~/.local/state/omarchy/zen/stats.json")
MEDITATION_LOG_HEADER = (
    "# Meditation Log\n"
    "\n"
    "Sessions logged by Terminal-Breather (fork of luotao.zen) — one row per session, appended automatically when a session ends.\n"
    "\n"
    "| Date | Pattern | Minutes | Completed |\n"
    "| --- | --- | --- | --- |"
)


def default_log_path(home):
    """The vault default meditation log, mirroring meditationLogPath()."""
    return (home or "") + "/Projects/Obsidian/Aventurine/20_Practices/Meditation/Meditation Log.md"


def normalize_log_path(raw, home):
    """Port of ZenModel.js normalizeLogPath: the absolute path to save,
    "" for "use the vault default", or None when the input is not a
    usable path (whitespace-only, relative, or a bare ~ with no home)."""
    text = "" if raw is None else str(raw)
    if text == "":
        return ""
    trimmed = text.strip()
    if trimmed == "":
        return None
    expanded = trimmed
    if expanded == "~":
        if not home:
            return None
        expanded = str(home)
    elif expanded.startswith("~/"):
        if not home:
            return None
        expanded = str(home) + expanded[1:]
    if not expanded.startswith("/"):
        return None
    return expanded


def _reject_json_constant(name):
    """json parse_constant hook: NaN, Infinity and -Infinity are not JSON.
    ZenModel.js's JSON.parse rejects them, so the guide treats them as
    malformed input too, or it would read a file the overlay ignores."""
    raise ValueError("non-standard JSON constant: " + name)


def resolve_log_path():
    """The meditation-log path for this session: the meditationLogPath setting
    from shell.json (normalised), or the vault default. An unusable setting, such
    as a relative path, falls back to the default; the panel never saves one."""
    home = os.path.expanduser("~")
    normalized = normalize_log_path(breather_setting("meditationLogPath", ""), home)
    if normalized is None or normalized == "":
        return default_log_path(home)
    return normalized


def breather_setting(key, fallback):
    """The value of key in the aven.terminal-breather bar entry of shell.json,
    or fallback when the file, the entry or the key is missing or unreadable."""
    try:
        with open(os.path.expanduser("~/.config/omarchy/shell.json")) as f:
            data = json.load(f, parse_constant=_reject_json_constant)
    except (OSError, ValueError):
        return fallback
    return _find_breather_setting(data, key, fallback)


def log_enabled():
    """Whether session rows go to the meditation log: meditationLogEnabled from
    shell.json, on unless it is false. The overlay reads the same key, so the
    bar and the terminal guide agree on the Off setting."""
    return flag_setting(breather_setting("meditationLogEnabled", True), True)


def flag_setting(value, fallback):
    """Port of ZenModel.js flagSetting: an explicit boolean, or its string form
    ("true"/"false"), else fallback. Other values, such as 0 or null, are absent."""
    if value is False or value == "false":
        return False
    if value is True or value == "true":
        return True
    return fallback


def _find_breather_setting(data, key, fallback):
    """Walk shell.json and return key from the aven.terminal-breather bar entry."""
    if isinstance(data, dict):
        if data.get("id") == "aven.terminal-breather" and key in data:
            return data[key]
        for value in data.values():
            found = _find_breather_setting(value, key, None)
            if found is not None:
                return found
    elif isinstance(data, list):
        for value in data:
            found = _find_breather_setting(value, key, None)
            if found is not None:
                return found
    return fallback


def parse_stats(raw):
    """Port of ZenModel.js parseStats: {"days": {...}} or {} on bad input."""
    stats = parse_stats_strict(raw)
    return stats if stats is not None else {"days": {}}


def parse_stats_strict(raw):
    """Like parse_stats, but None for input that is not a stats file, so a
    writer can tell "no history yet" from "history it must not overwrite"."""
    try:
        parsed = json.loads(raw or "{}", parse_constant=_reject_json_constant)
    except (ValueError, TypeError):
        return None
    if isinstance(parsed, dict) and isinstance(parsed.get("days"), dict):
        return {"days": parsed["days"]}
    return None


def _minutes_of(value):
    """Port of ZenModel.js `Number(x) || 0` for a stored day total: a value that
    is not a finite number counts as no minutes rather than failing the merge."""
    try:
        number = float(value)
    except (TypeError, ValueError, OverflowError):
        return 0
    return number if math.isfinite(number) else 0


def add_minutes(stats, day_key, minutes):
    """Port of ZenModel.js addMinutes: minutes are rounded when added."""
    days = dict(stats.get("days", {}))
    days[day_key] = round(_minutes_of(days.get(day_key)) + minutes)
    return {"days": days}


DAY_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}")
MINUTES_RE = re.compile(r"[1-9][0-9]{0,5}")


def add_stats_minutes(path, day_key, minutes, seed_path=None):
    """Adds minutes to one day of the stats file at path, safely against other writers.

    The read, merge and write run under an exclusive flock on path + ".lock". The
    lock sits on a sibling file because the stats file is replaced by rename, which
    would orphan a lock held on it. The merge re-reads the file on disk, so minutes
    that another session or the terminal guide wrote since this process started are
    kept. The new contents go to a temp file that is fsynced and renamed over path, so
    an interrupted write leaves the previous file intact.

    seed_path, when given, is omarchy-zen's stats file. On the first run, before the
    one-time copy is marked done (see seed_stats), a missing path starts from a copy
    of its history, so a first session that runs before any seeding still carries the
    old totals over. The write then marks the copy done, so seed_path is never read
    again, even if path is later deleted.

    Raises OSError when the file cannot be read or replaced; path is then unchanged.
    Creates missing parent directories and keeps the file's permission bits.
    """
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path + ".lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        first_run = seed_path is not None and not os.path.lexists(path + SEEDED_SUFFIX)
        stats, mode = _read_stats_locked(path, seed_path if first_run else None)
        stats = add_minutes(stats, day_key, minutes)
        _replace_file(path, json.dumps(stats, separators=(",", ":")).encode("utf-8"), mode)
        if first_run:
            _mark_seeded(path)


# Beside the stats file, an empty marker that the one-time copy from omarchy-zen's
# file is done. It outlives the stats file, so deleting Breather's stats.json resets
# its history to empty rather than re-importing Zen's.
SEEDED_SUFFIX = ".seeded"


def seed_stats(path, seed_path):
    """First run: creates the stats file at path from a copy of seed_path, once.

    seed_path is omarchy-zen's stats file. It is opened read-only, never locked,
    renamed or written, so its bytes and mtime stay as Zen left them. It is read only
    while the copy is not yet marked done (path + SEEDED_SUFFIX) and path does not
    exist; either way the call ends with the marker in place, so afterwards seed_path
    is never read and Breather's history is its own. A seed that is a stats file is
    copied byte for byte with its permission bits; a missing, empty or unparseable
    seed gives an empty history, so the first run still ends with path in place.

    Runs under the same lock as add_stats_minutes, so it cannot race a session's
    write. Returns True when it created path, False otherwise.
    Raises OSError when the seed cannot be read or path cannot be written.
    """
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path + ".lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if os.path.lexists(path + SEEDED_SUFFIX):
            return False
        created = not os.path.lexists(path)
        if created:
            raw, mode = _read_seed(seed_path)
            _replace_file(path, raw if raw is not None else b'{"days":{}}', mode)
        _mark_seeded(path)
        return created


def _mark_seeded(path):
    """Creates the empty SEEDED_SUFFIX marker beside path. Called under path's lock,
    after path is written: a crash in between leaves path in place, which alone keeps
    the seed from being read again."""
    open(path + SEEDED_SUFFIX, "a").close()


# A seed that does not parse is re-read this many times, SEED_REREAD_DELAY seconds
# apart, before it is treated as holding no history. omarchy-zen writes its
# stats.json in place (truncate, then write) without a lock, so a read can land
# between the two; its write is a few hundred bytes and finishes long before the
# next try.
SEED_REREADS = 5
SEED_REREAD_DELAY = 0.05


def _read_seed(seed_path):
    """Reads omarchy-zen's stats file for seeding; returns (raw, mode).

    raw is the file's bytes when they are a stats file, else None (missing, empty,
    or still unparseable after SEED_REREADS re-reads); mode is its permission bits,
    or 0644 when raw is None. Read-only: the seed is never repaired or set aside,
    since it belongs to Zen. Read errors other than a missing file propagate.
    """
    for attempt in range(SEED_REREADS + 1):
        try:
            mode = stat.S_IMODE(os.stat(seed_path).st_mode)
            with open(seed_path, "rb") as f:
                raw = f.read()
        except FileNotFoundError:
            return None, 0o644
        if raw.strip() and parse_stats_strict(raw) is not None:
            return raw, mode
        if attempt < SEED_REREADS:
            time.sleep(SEED_REREAD_DELAY)
    return None, 0o644


def _read_stats_locked(path, seed_path=None):
    """Reads the stats file for a locked merge and returns (stats, mode).

    A missing file gives the seed's history and permission bits when seed_path is
    given (see seed_stats), else empty stats and mode 0644. An empty file holds
    no history and gives empty stats. A file that is not a stats file (edited by
    hand, say) is renamed to path + ".corrupt-<time>" rather than overwritten, so its
    history can still be recovered by hand. No re-read is needed: every writer of
    path replaces it atomically. Other read errors propagate, so nothing is written
    over a file that was not read.
    """
    try:
        mode = stat.S_IMODE(os.stat(path).st_mode)
        with open(path, "rb") as f:
            raw = f.read()
    except FileNotFoundError:
        if seed_path is None:
            return {"days": {}}, 0o644
        raw, mode = _read_seed(seed_path)
        return (parse_stats_strict(raw) if raw is not None else {"days": {}}), mode
    if not raw.strip():
        return {"days": {}}, mode
    stats = parse_stats_strict(raw)
    if stats is not None:
        return stats, mode
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    os.replace(path, "%s.corrupt-%s" % (path, stamp))
    return {"days": {}}, mode


def _replace_file(path, data, mode):
    """Writes data (bytes) to a temp file beside path, fsyncs it, and renames it over
    path, so a reader sees either the old file or the new one, never a partial write.
    The temp file is removed on any failure before the rename."""
    directory = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=directory, prefix="." + os.path.basename(path) + ".", suffix=".tmp")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    _fsync_dir(directory)


def _fsync_dir(directory):
    """Makes a rename in directory durable. Best effort: the new file is already
    in place, so a failure here does not undo the write."""
    try:
        fd = os.open(directory, os.O_RDONLY)
    except OSError:
        return
    try:
        os.fsync(fd)
    except OSError:
        pass
    finally:
        os.close(fd)


def log_row(date_key, pattern_name, minutes, completed):
    """Port of ZenModel.js logRow. Pattern names are scrubbed so pipes
    and newlines can never break the table or the line."""
    name = re.sub(r"[|\r\n]", " ", str(pattern_name or ""))
    name = re.sub(r"\s+", " ", name).strip()
    if not name:
        name = "Unknown"
    return "| %s | %s | %d | %s |" % (
        date_key, name, int(minutes) if minutes else 0,
        "yes" if completed else "no")


def log_session(pattern_name, elapsed_secs, total_secs, completed):
    """Log a finished session the way BreatheOverlay.endSession does.

    minutes is floor(elapsed / 60) when ended early, or max(1,
    round(total / 60)) when completed. Nothing is logged under one
    minute. The minutes are merged into Breather's stats file under its
    lock, seeded from omarchy-zen's file on the first run (see
    add_stats_minutes). The meditation log is written unless
    meditationLogEnabled is false: it is created with the header when
    missing, and the row is skipped silently when its folder is gone (no
    mkdir — the row never lands somewhere the vault is not). Returns the
    minutes logged, or 0 when nothing was.
    """
    if completed:
        minutes = max(1, round(total_secs / 60))
    else:
        minutes = int(elapsed_secs // 60)
    if minutes < 1:
        return 0

    today = datetime.now().strftime("%Y-%m-%d")

    try:
        add_stats_minutes(STATS_PATH, today, minutes, ZEN_STATS_PATH)
    except OSError:
        pass

    if not log_enabled():
        return minutes

    log_path = resolve_log_path()
    try:
        if not os.path.isdir(os.path.dirname(log_path)):
            return minutes
        row = log_row(today, pattern_name, minutes, completed)
        if not os.path.isfile(log_path):
            with open(log_path, "w") as f:
                f.write(MEDITATION_LOG_HEADER + "\n")
        with open(log_path, "a") as f:
            f.write(row + "\n")
    except OSError:
        pass
    return minutes


# Custom-pattern validation and phase timing mirror ZenModel.js. Fullness
# motion is linear here, unlike the eased overlay (see breath_at).
KEY_RE = re.compile(r"[a-z0-9][a-z0-9-]*")


def _is_num(v):
    """A JSON number. bool is excluded: True is not a number of seconds."""
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def _finite(v):
    """True for a finite JSON number. A JSON integer with hundreds of digits is
    valid JSON but overflows float(); it counts as not finite, as JS Number()
    makes such a literal Infinity in ZenModel.js."""
    try:
        return math.isfinite(v)
    except OverflowError:
        return False


# Limits on custom-pattern numbers, mirrored in ZenModel.js. Built-in patterns
# use short phases without ramps; the example Breath of Fire ramps from 2 to 0.5.
# These bounds keep `secs * scale` finite before math.ceil; over-limit phases
# are skipped and an invalid ramp is dropped while keeping its pattern.
MAX_PHASE_SECS = 3600.0
MAX_RAMP_OVER_SECS = 3600.0
MIN_RAMP_FACTOR = 0.01
MAX_RAMP_FACTOR = 100.0


def _valid_phase(ph):
    """Port of ZenModel.js isValidPhase: a label, secs above 0 and at most
    MAX_PHASE_SECS, and a target fullness of exactly 0 or 1."""
    return (isinstance(ph, dict) and isinstance(ph.get("label"), str)
            and ph["label"] != "" and _is_num(ph.get("secs"))
            and _finite(ph["secs"]) and 0 < ph["secs"] <= MAX_PHASE_SECS
            and _is_num(ph.get("to")) and ph["to"] in (0, 1))


def _valid_ramp(r):
    """Port of ZenModel.js validRamp: from and to are finite factors within
    [MIN_RAMP_FACTOR, MAX_RAMP_FACTOR]; overSecs is finite, above 0 and at
    most MAX_RAMP_OVER_SECS; and to/from is a finite positive ratio. A ratio
    that underflows to 0 or overflows to inf would make ramp_base_time take
    log(0) or return inf mid-session."""
    if not isinstance(r, dict):
        return False
    if not all(_is_num(r.get(k)) and _finite(r[k]) for k in ("from", "to", "overSecs")):
        return False
    if not (MIN_RAMP_FACTOR <= r["from"] <= MAX_RAMP_FACTOR
            and MIN_RAMP_FACTOR <= r["to"] <= MAX_RAMP_FACTOR
            and 0 < r["overSecs"] <= MAX_RAMP_OVER_SECS):
        return False
    ratio = float(r["to"]) / float(r["from"])
    return math.isfinite(ratio) and ratio > 0


def load_custom_patterns():
    """Custom patterns from ~/.config/omarchy/zen/patterns.json, validated the
    way ZenModel.js parseCustomPatterns validates them. Keys are lowercased; a
    key seen earlier in the file (even on a bad entry) blocks later ones; a key
    that collides with a built-in is ignored; a bad entry is skipped. A malformed
    file yields no custom patterns rather than an error."""
    path = os.path.expanduser("~/.config/omarchy/zen/patterns.json")
    out = {}
    try:
        with open(path) as f:
            data = json.load(f, parse_constant=_reject_json_constant)
    except (OSError, ValueError):
        return out
    entries = data.get("patterns") if isinstance(data, dict) else None
    if not isinstance(entries, list):
        return out
    seen = set()
    for p in entries:
        if not isinstance(p, dict) or not isinstance(p.get("key"), str):
            continue
        key = p["key"].lower()
        if not KEY_RE.fullmatch(key) or key in seen:
            continue
        seen.add(key)
        if key in BUILTIN:
            continue
        name = p.get("name")
        phases = p.get("phases")
        if not isinstance(name, str) or name == "":
            continue
        if not isinstance(phases, list) or len(phases) < 2:
            continue
        if not all(_valid_phase(ph) for ph in phases):
            continue
        entry = {
            "name": name,
            "phases": [(ph["label"], float(ph["secs"]), float(ph["to"])) for ph in phases],
        }
        ramp = p.get("ramp")
        if _valid_ramp(ramp):
            entry["ramp"] = {k: float(ramp[k]) for k in ("from", "to", "overSecs")}
        out[key] = entry
    return out


def resolve_pattern(key):
    """The pattern for key, as ZenModel.pattern resolves it: keys ignore case,
    custom patterns come from patterns.json, and an unknown key is box."""
    key = str(key or "").lower()
    custom = load_custom_patterns()
    if key in custom:
        return custom[key]
    return BUILTIN.get(key, BUILTIN["box"])


def ramp_scale(pat, t):
    """Port of ZenModel.js rampScale: the tempo multiplier t seconds into a
    session (1 with no ramp). It moves linearly from `from` to `to` over
    `overSecs`, then holds."""
    ramp = pat.get("ramp")
    if not ramp:
        return 1.0
    f = min(max(t / ramp["overSecs"], 0.0), 1.0)
    return ramp["from"] + (ramp["to"] - ramp["from"]) * f


def ramp_base_time(pat, t):
    """Port of ZenModel.js rampBaseTime: the written-pattern seconds that have
    passed after t real seconds, integrating 1/scale over the ramp."""
    t = max(t, 0.0)
    ramp = pat.get("ramp")
    if not ramp:
        return t
    r0, r1, over = ramp["from"], ramp["to"], ramp["overSecs"]
    if r1 == r0:
        return t / r0
    if t <= over:
        return over / (r1 - r0) * math.log((r0 + (r1 - r0) * t / over) / r0)
    done = over / (r1 - r0) * math.log(r1 / r0)
    return done + (t - over) / r1


def breath_at(pat, elapsed):
    """Port the overlay's phase timeline without its half-cosine fullness easing.
    The terminal renderer quantizes fullness to cells, so keeping its motion
    linear avoids a separate easing path while preserving phase timing and ramp
    speed. For elapsed real seconds, return (label, whole seconds left in the
    phase at the session's tempo, fullness in [0, 1]).
    """
    phases = pat["phases"]
    cycle = sum(ph[1] for ph in phases)
    into = ramp_base_time(pat, elapsed) % cycle
    scale = ramp_scale(pat, elapsed)
    frm = phases[-1][2]
    for label, secs, to in phases:
        if into < secs:
            return label, math.ceil((secs - into) * scale), frm + (to - frm) * (into / secs)
        into -= secs
        frm = to
    return phases[0][0], math.ceil(phases[0][1] * scale), frm


def fmt_clock(total_secs):
    total_secs = max(0, int(math.ceil(total_secs)))
    return "%d:%02d" % (total_secs // 60, total_secs % 60)


def circle_block(radius, max_radius, colour):
    """Render the breathing circle as a fixed-height block of lines.

    Always returns 2 * max_radius + 1 lines so the block height never
    changes as the circle grows and shrinks (which keeps the redraw
    stable). The circle is centred vertically in the block.
    """
    height = 2 * max_radius + 1
    half_w = int(max_radius * ASPECT)
    lines = []
    for row in range(height):
        y = row - max_radius
        line = ""
        for col in range(-half_w, half_w + 1):
            d = math.sqrt((col / ASPECT) ** 2 + y ** 2)
            if d <= radius - 0.6:
                line += "●"
            elif d <= radius:
                line += "○"
            else:
                line += " "
        lines.append(line.rstrip())
    # Colour the whole circle; the text lines are drawn uncoloured.
    coloured = ["\x1b[%sm%s%s" % (colour, ln, RESET) if ln.strip() else ln for ln in lines]
    return coloured


DEFAULT_MINUTES = 5
MAX_MINUTES = 120  # longest session the CLI accepts; bounds accidental runs


def parse_minutes(raw):
    """Return the session length in minutes for a CLI argument.

    raw is the argv string, or None when absent. Invalid and nonpositive
    values give DEFAULT_MINUTES; valid values above MAX_MINUTES are clamped
    to it, so arbitrarily large integers cannot start an enormous session.
    Non-integer text such as "2.5" counts as invalid.
    """
    try:
        minutes = int(raw)
    except (TypeError, ValueError):
        return DEFAULT_MINUTES
    if minutes <= 0:
        return DEFAULT_MINUTES
    return min(minutes, MAX_MINUTES)


def record_stats(args):
    """Entry point of `tb-guide --record-stats PATH DAY MINUTES [SEED]`, the
    stats-only write the overlay makes after a session. PATH must be absolute, DAY
    is YYYY-MM-DD and MINUTES is 1 to 999999; SEED, when given, is the absolute path
    of omarchy-zen's stats file to copy history from if PATH does not exist yet (see
    add_stats_minutes). Nothing is written for bad arguments.

    Returns 0 on success, 2 for bad arguments, and 1 when the file cannot be
    written (the error goes to stderr).
    """
    if (len(args) not in (3, 4) or not all(os.path.isabs(p) for p in args[:1] + args[3:])
            or not DAY_RE.fullmatch(args[1]) or not MINUTES_RE.fullmatch(args[2])):
        sys.stderr.write("usage: tb-guide --record-stats PATH YYYY-MM-DD MINUTES [SEED]\n")
        return 2
    try:
        add_stats_minutes(args[0], args[1], int(args[2]), args[3] if len(args) == 4 else None)
    except OSError as e:
        sys.stderr.write("tb-guide: could not record stats: %s\n" % e)
        return 1
    return 0


def seed_stats_cli(args):
    """Entry point of `tb-guide --seed-stats PATH SEED`, the first-run copy the bar
    and overlay run when they load: creates PATH from SEED, omarchy-zen's stats file,
    unless PATH exists (see seed_stats). Both paths must be absolute.

    Returns 0 whether or not a copy was made, 2 for bad arguments, and 1 when the
    seed cannot be read or PATH cannot be written (the error goes to stderr).
    """
    if len(args) != 2 or not all(os.path.isabs(p) for p in args):
        sys.stderr.write("usage: tb-guide --seed-stats PATH SEED\n")
        return 2
    try:
        seed_stats(args[0], args[1])
    except OSError as e:
        sys.stderr.write("tb-guide: could not seed stats: %s\n" % e)
        return 1
    return 0


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--record-stats":
        return record_stats(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "--seed-stats":
        return seed_stats_cli(sys.argv[2:])
    pattern_key = sys.argv[1] if len(sys.argv) > 1 else "box"
    minutes = parse_minutes(sys.argv[2] if len(sys.argv) > 2 else None)

    pat = resolve_pattern(pattern_key)
    total_secs = minutes * 60

    # Size the circle to the terminal (narrow phone screens included).
    try:
        cols, rows = shutil.get_terminal_size()
    except OSError:
        cols, rows = 80, 24
    max_radius = max(3, min(9, (cols // 2 - 2) // 2, (rows - 8) // 2))
    max_radius = min(max_radius, 10)

    stop = {"flag": False}

    def on_sigint(signum, frame):
        stop["flag"] = True

    signal.signal(signal.SIGINT, on_sigint)

    circle_height = 2 * max_radius + 1
    text_lines = 3  # phase, countdown, hint
    block_lines = circle_height + text_lines

    sys.stdout.write("\x1b[?25l")  # hide cursor
    sys.stdout.flush()
    try:
        print("Terminal Breather — %s · %d min" % (pat["name"], minutes))
        print("Ctrl+C to end early. Sessions under a minute are not logged.")
        print()
        for _ in range(block_lines):
            print()

        start = time.monotonic()
        while True:
            elapsed = time.monotonic() - start
            remaining = total_secs - elapsed
            if remaining <= 0 or stop["flag"]:
                break
            label, phase_left, fullness = breath_at(pat, elapsed)
            radius = MIN_RADIUS + fullness * (max_radius - MIN_RADIUS)
            colour = PHASE_COLOURS.get(label, "36")

            lines = circle_block(radius, max_radius, colour)
            lines.append(label)
            lines.append("%d · %s left" % (phase_left, fmt_clock(remaining)))
            lines.append("")

            sys.stdout.write("\x1b[%dA" % block_lines)
            for ln in lines:
                sys.stdout.write("\r\x1b[K%s\n" % ln)
            sys.stdout.flush()
            time.sleep(0.08)
    finally:
        sys.stdout.write("\x1b[?25h")  # show cursor again
        sys.stdout.flush()

    elapsed = time.monotonic() - start
    completed = elapsed >= total_secs and not stop["flag"]
    logged = log_session(pat["name"], elapsed, total_secs, completed)
    print()
    if completed:
        if logged >= 1:
            print("Done — %s · %s. Logged %d min to your meditation log." % (
                pat["name"], fmt_clock(elapsed), logged))
        else:
            print("Done — %s · %s. Nice work." % (pat["name"], fmt_clock(elapsed)))
    else:
        if logged >= 1:
            print("Ended early after %s — logged %d min." % (
                fmt_clock(elapsed), logged))
        else:
            print("Ended early after %s (under a minute — not logged)." % fmt_clock(elapsed))
    return 0


if __name__ == "__main__":
    sys.exit(main())
