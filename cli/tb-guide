def default_log_path(home):
    """The vault default meditation log, mirroring meditationLogPath()."""
    return (home or "") + "/Projects/Obsidian/Aventurine/20_Practices/Meditation/Meditation Log.md"


def normalize_log_path(raw, home):
    """Port of ZenModel.js normalizeLogPath: the absolute path to save,
    "" for "use the vault default", or None when the input is not a
    usable path (whitespace-only, relative, or a bare ~ with no home)."""
    text = "" if raw is None else str(raw)
    if text == "":
        return ""
    trimmed = text.strip()
    if trimmed == "":
        return None
    expanded = trimmed
    if expanded == "~":
        if not home:
            return None
        expanded = str(home)
    elif expanded.startswith("~/"):
        if not home:
            return None
        expanded = str(home) + expanded[1:]
    if not expanded.startswith("/"):
        return None
    return expanded


def _reject_json_constant(name):
    """json parse_constant hook: NaN, Infinity and -Infinity are not JSON.
    ZenModel.js's JSON.parse rejects them, so the guide treats them as
    malformed input too, or it would read a file the overlay ignores."""
    raise ValueError("non-standard JSON constant: " + name)


def resolve_log_path():
    """The meditation-log path for this session: the meditationLogPath setting
    from shell.json (normalised), or the vault default. An unusable setting, such
    as a relative path, falls back to the default; the panel never saves one."""
    home = os.path.expanduser("~")
    normalized = normalize_log_path(breather_setting("meditationLogPath", ""), home)
    if normalized is None or normalized == "":
        return default_log_path(home)
    return normalized


def breather_setting(key, fallback):
    """The value of key in the aven.terminal-breather bar entry of shell.json,
    or fallback when the file, the entry or the key is missing or unreadable."""
    try:
        with open(os.path.expanduser("~/.config/omarchy/shell.json")) as f:
            data = json.load(f, parse_constant=_reject_json_constant)
    except (OSError, ValueError):
        return fallback
    return _find_breather_setting(data, key, fallback)


def log_enabled():
    """Whether session rows go to the meditation log: meditationLogEnabled from
    shell.json, on unless it is false. The overlay reads the same key, so the
    bar and the terminal guide agree on the Off setting."""
    return flag_setting(breather_setting("meditationLogEnabled", True), True)


def flag_setting(value, fallback):
    """Port of ZenModel.js flagSetting: an explicit boolean, or its string form
    ("true"/"false"), else fallback. Other values, such as 0 or null, are absent."""
    if value is False or value == "false":
        return False
    if value is True or value == "true":
        return True
    return fallback


def _find_breather_setting(data, key, fallback):
    """Walk shell.json and return key from the aven.terminal-breather bar entry."""
    if isinstance(data, dict):
        if data.get("id") == "aven.terminal-breather" and key in data:
            return data[key]
        for value in data.values():
            found = _find_breather_setting(value, key, None)
            if found is not None:
                return found
    elif isinstance(data, list):
        for value in data:
            found = _find_breather_setting(value, key, None)
            if found is not None:
                return found
    return fallback


def parse_stats(raw):
    """Port of ZenModel.js parseStats: {"days": {...}} or {} on bad input."""
    stats = parse_stats_strict(raw)
    return stats if stats is not None else {"days": {}}


def parse_stats_strict(raw):
    """Like parse_stats, but None for input that is not a stats file, so a
    writer can tell "no history yet" from "history it must not overwrite"."""
    try:
        parsed = json.loads(raw or "{}", parse_constant=_reject_json_constant)
    except (ValueError, TypeError):
        return None
    if isinstance(parsed, dict) and isinstance(parsed.get("days"), dict):
        return {"days": parsed["days"]}
    return None


def _minutes_of(value):
    """Port of ZenModel.js `Number(x) || 0` for a stored day total: a value that
    is not a finite number counts as no minutes rather than failing the merge."""
    try:
        number = float(value)
    except (TypeError, ValueError, OverflowError):
        return 0
    return number if math.isfinite(number) else 0


def add_minutes(stats, day_key, minutes):
    """Port of ZenModel.js addMinutes: minutes are rounded when added."""
    days = dict(stats.get("days", {}))
    days[day_key] = round(_minutes_of(days.get(day_key)) + minutes)
    return {"days": days}


DAY_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}")
MINUTES_RE = re.compile(r"[1-9][0-9]{0,5}")


def add_stats_minutes(path, day_key, minutes):
    """Adds minutes to one day of the stats file at path, safely against other writers.

    Cooperating writers (other sessions, the bar, tb-guide) serialise on an exclusive
    flock on path + ".lock" (the shared-lock convention in the README). The lock sits
    on a sibling file because the stats file is replaced by rename, which would orphan
    a lock held on it.

    omarchy-zen does not take that lock: it truncates the file and writes a whole
    snapshot in place. So the write never trusts a snapshot. It reads the file on
    disk, adds only these minutes to it (a delta merge), writes the result to a
    fsynced temp file, then checks that the path still holds the inode and bytes it
    read before renaming the temp file over it. A change in between means another
    writer landed: the temp file is dropped and the merge starts again from the new
    contents. After the rename it checks the replaced inode once more, because a
    writer that opened the file just before the rename writes into that orphan; the
    minutes such a write added are merged into the new file. See _merge_stats_delta.

    Raises OSError when the file cannot be read or replaced, or when it kept changing
    for STATS_WRITE_ATTEMPTS tries; path is then left as the other writer wrote it.
    Creates missing parent directories and keeps the file's permission bits.
    """
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path + ".lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        _merge_stats_delta(path, {day_key: minutes})


# A file that does not parse is re-read this many times, STATS_REREAD_DELAY
# seconds apart, before it is treated as corrupt. omarchy-zen writes stats.json in
# place (truncate, then write) without the lock, so a read can land between the two;
# its write is a few hundred bytes and finishes long before the next try.
STATS_REREADS = 5
STATS_REREAD_DELAY = 0.05

# Merge attempts before a write gives up. An attempt is retried only when another
# writer changed the file inside its read-to-rename window (a few milliseconds), so
# needing this many means something is rewriting the file continuously; failing
# then beats holding the lock in a loop.
STATS_WRITE_ATTEMPTS = 8


def _merge_stats_delta(path, delta):
    """Adds delta ({day: minutes}) to the stats file at path; the caller holds the lock.

    Each attempt reads the file, writes file + delta to a temp file and renames it
    over path only if path still holds the inode and bytes that were read
    (_replace_if_unchanged). A late write into the replaced inode is folded in by a
    further attempt whose delta is the minutes that write added (_gained_minutes).

    Raises OSError on read or write failure, or after STATS_WRITE_ATTEMPTS attempts.
    """
    pending = delta
    for _ in range(STATS_WRITE_ATTEMPTS):
        stats, mode, raw, fd = _read_stats_locked(path)
        try:
            merged = stats
            for day_key, minutes in pending.items():
                merged = add_minutes(merged, day_key, minutes)
            text = json.dumps(merged, separators=(",", ":"))
            if not _replace_if_unchanged(path, text, mode, fd, raw):
                continue
            late = _late_write(path, fd, raw)
        finally:
            os.close(fd)
        if late is None:
            return
        pending = _gained_minutes(stats, late)
        if not pending:
            return
    raise OSError("%s kept changing under another writer; gave up after %d attempts"
                  % (path, STATS_WRITE_ATTEMPTS))


def _gained_minutes(base, later):
    """The minutes later holds beyond base, per day, as a delta for another merge.

    Only increases count. A day that is lower (or missing) in later comes from a
    snapshot taken before base was written, not from minutes being taken away, so
    it must not subtract from the totals already on disk.
    """
    gained = {}
    base_days = base.get("days", {})
    for day_key, value in later.get("days", {}).items():
        extra = _minutes_of(value) - _minutes_of(base_days.get(day_key))
        if extra > 0:
            gained[day_key] = extra
    return gained


def _read_all(fd):
    """The whole current contents of the file open at fd, read from offset 0."""
    chunks = []
    offset = 0
    while True:
        chunk = os.pread(fd, 65536, offset)
        if not chunk:
            return b"".join(chunks)
        chunks.append(chunk)
        offset += len(chunk)


def _open_stats(path):
    """Opens path (creating it empty, 0644 less the umask, when missing) and reads it,
    re-reading unparseable text up to STATS_REREADS times so that an in-place write
    caught half-way is read once it lands. Returns (fd, raw, stats), where stats is
    None when raw is still empty or not a stats file. The caller closes fd.

    The missing file is created rather than left missing so that a first write by
    omarchy-zen, which opens the path with O_CREAT|O_TRUNC, lands in an inode this
    writer holds open and can check after its rename.
    """
    fd = None
    try:
        for attempt in range(STATS_REREADS + 1):
            if fd is not None:
                os.close(fd)
                fd = None
            fd = os.open(path, os.O_RDONLY | os.O_CREAT, 0o644)
            raw = _read_all(fd)
            stats = parse_stats_strict(raw) if raw.strip() else None
            if stats is not None:
                break
            if attempt < STATS_REREADS:
                time.sleep(STATS_REREAD_DELAY)
    except BaseException:
        if fd is not None:
            os.close(fd)
        raise
    return fd, raw, stats


def _read_stats_locked(path):
    """Reads the stats file for a locked merge and returns (stats, mode, raw, fd).

    fd stays open on the inode that was read, and raw is the exact bytes read from
    it; the caller compares both with the path before and after replacing it, then
    closes fd. A missing file is created empty (see _open_stats). Empty text holds no
    history and gives empty stats. Unparseable text is re-read a few times first
    (see STATS_REREADS); a file still not a stats file (a truncated write from an
    older, non-atomic writer, say) is renamed to path + ".corrupt-<time>" rather than
    overwritten, so its history can still be recovered by hand, and the merge starts
    from a fresh empty file. Other read errors propagate, so nothing is written over
    a file that was not read.
    """
    fd, raw, stats = _open_stats(path)
    if stats is None and raw.strip():
        os.close(fd)
        _set_aside(path)
        fd, raw, stats = _open_stats(path)
        if stats is None and raw.strip():
            os.close(fd)
            raise OSError("%s is not a stats file" % path)
    try:
        mode = stat.S_IMODE(os.fstat(fd).st_mode)
    except BaseException:
        os.close(fd)
        raise
    return (stats if stats is not None else {"days": {}}), mode, raw, fd


def _corrupt_path(path):
    """The name a stats file that does not parse is kept under: path.corrupt-<time>."""
    return "%s.corrupt-%s" % (path, datetime.now().strftime("%Y%m%d-%H%M%S"))


def _set_aside(path):
    """Renames the unparseable stats file at path to its .corrupt-<time> name."""
    os.replace(path, _corrupt_path(path))


def _still_current(path, fd, raw):
    """Whether path still names the inode open at fd and that inode still holds raw.

    The bytes are compared in full rather than by size or mtime: an in-place
    rewrite of the same length within one timestamp tick would pass those."""
    try:
        on_path = os.stat(path)
    except FileNotFoundError:
        return False
    held = os.fstat(fd)
    if (on_path.st_dev, on_path.st_ino) != (held.st_dev, held.st_ino):
        return False
    return _read_all(fd) == raw


def _replace_if_unchanged(path, text, mode, fd, raw):
    """Writes text to a fsynced temp file beside path and renames it over path,
    unless path no longer holds what was read (see _still_current).

    The check runs after the slow part (the temp write and fsync), right before the
    rename, so the window in which an unlocked writer can still slip in is the
    check and the rename syscall alone; _late_write covers that window afterwards.
    A reader sees either the old file or the new one, never a partial write.

    Returns True when path was replaced, False when it changed and was left alone.
    The temp file is removed whenever path is not replaced.
    """
    directory = os.path.dirname(path) or "."
    fd_tmp, tmp = tempfile.mkstemp(dir=directory, prefix="." + os.path.basename(path) + ".", suffix=".tmp")
    replaced = False
    try:
        with os.fdopen(fd_tmp, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        if _still_current(path, fd, raw):
            os.replace(tmp, path)
            replaced = True
    finally:
        if not replaced:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    if replaced:
        _fsync_dir(directory)
    return replaced


def _late_write(path, fd, raw):
    """Checks the inode a rename just replaced for a write that reached it too late.

    An unlocked writer that opened the file just before the rename writes into
    that inode, which no longer has a name, so its minutes would vanish. When the
    inode no longer holds raw, the late write is re-read until it parses (it may be
    a truncate caught before its write) and returned as stats for the caller to
    merge. Returns None when nothing changed or the late write left nothing usable:
    a write still empty after the re-reads carried nothing to keep, and unparseable
    bytes are copied to path.corrupt-<time> for recovery by hand.
    """
    now = _read_all(fd)
    if now == raw:
        return None
    for attempt in range(STATS_REREADS + 1):
        stats = parse_stats_strict(now) if now.strip() else None
        if stats is not None:
            return stats
        if attempt < STATS_REREADS:
            time.sleep(STATS_REREAD_DELAY)
            now = _read_all(fd)
    if now.strip():
        # "x": a .corrupt copy already made this second is kept, not written over.
        try:
            with open(_corrupt_path(path), "xb") as f:
                f.write(now)
        except FileExistsError:
            pass
    return None


def _fsync_dir(directory):
    """Makes a rename in directory durable. Best effort: the new file is already
    in place, so a failure here does not undo the write."""
    try:
        fd = os.open(directory, os.O_RDONLY)
    except OSError:
        return
    try:
        os.fsync(fd)
    except OSError:
        pass
    finally:
        os.close(fd)


def log_row(date_key, pattern_name, minutes, completed):
    """Port of ZenModel.js logRow. Pattern names are scrubbed so pipes
    and newlines can never break the table or the line."""
    name = re.sub(r"[|\r\n]", " ", str(pattern_name or ""))
    name = re.sub(r"\s+", " ", name).strip()
    if not name:
        name = "Unknown"
    return "| %s | %s | %d | %s |" % (
        date_key, name, int(minutes) if minutes else 0,
        "yes" if completed else "no")


def log_session(pattern_name, elapsed_secs, total_secs, completed):
    """Log a finished session the way BreatheOverlay.endSession does.

    minutes is floor(elapsed / 60) when ended early, or max(1,
    round(total / 60)) when completed. Nothing is logged under one
    minute. The minutes are merged into the stats file under its lock
    (see add_stats_minutes). The meditation log is written unless
    meditationLogEnabled is false: it is created with the header when
    missing, and the row is skipped silently when its folder is gone (no
    mkdir — the row never lands somewhere the vault is not). Returns the
    minutes logged, or 0 when nothing was.
    """
    if completed:
        minutes = max(1, round(total_secs / 60))
    else:
        minutes = int(elapsed_secs // 60)
    if minutes < 1:
        return 0

    today = datetime.now().strftime("%Y-%m-%d")

    try:
        add_stats_minutes(STATS_PATH, today, minutes)
    except OSError:
        pass

    if not log_enabled():
        return minutes

    log_path = resolve_log_path()
    try:
        if not os.path.isdir(os.path.dirname(log_path)):
            return minutes
        row = log_row(today, pattern_name, minutes, completed)
        if not os.path.isfile(log_path):
            with open(log_path, "w") as f:
                f.write(MEDITATION_LOG_HEADER + "\n")
        with open(log_path, "a") as f:
            f.write(row + "\n")
    except OSError:
        pass
    return minutes


# Custom-pattern validation and phase timing mirror ZenModel.js. Fullness
# motion is linear here, unlike the eased overlay (see breath_at).
KEY_RE = re.compile(r"[a-z0-9][a-z0-9-]*")


def _is_num(v):
    """A JSON number. bool is excluded: True is not a number of seconds."""
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def _finite(v):
    """True for a finite JSON number. A JSON integer with hundreds of digits is
    valid JSON but overflows float(); it counts as not finite, as JS Number()
    makes such a literal Infinity in ZenModel.js."""
    try:
        return math.isfinite(v)
    except OverflowError:
        return False


# Limits on custom-pattern numbers, mirrored in ZenModel.js. Built-in patterns
# use short phases without ramps; the example Breath of Fire ramps from 2 to 0.5.
# These bounds keep `secs * scale` finite before math.ceil; over-limit phases
# are skipped and an invalid ramp is dropped while keeping its pattern.
MAX_PHASE_SECS = 3600.0
MAX_RAMP_OVER_SECS = 3600.0
MIN_RAMP_FACTOR = 0.01
MAX_RAMP_FACTOR = 100.0


def _valid_phase(ph):
    """Port of ZenModel.js isValidPhase: a label, secs above 0 and at most
    MAX_PHASE_SECS, and a target fullness of exactly 0 or 1."""
    return (isinstance(ph, dict) and isinstance(ph.get("label"), str)
            and ph["label"] != "" and _is_num(ph.get("secs"))
            and _finite(ph["secs"]) and 0 < ph["secs"] <= MAX_PHASE_SECS
            and _is_num(ph.get("to")) and ph["to"] in (0, 1))


def _valid_ramp(r):
    """Port of ZenModel.js validRamp: from and to are finite factors within
    [MIN_RAMP_FACTOR, MAX_RAMP_FACTOR]; overSecs is finite, above 0 and at
    most MAX_RAMP_OVER_SECS; and to/from is a finite positive ratio. A ratio
    that underflows to 0 or overflows to inf would make ramp_base_time take
    log(0) or return inf mid-session."""
    if not isinstance(r, dict):
        return False
    if not all(_is_num(r.get(k)) and _finite(r[k]) for k in ("from", "to", "overSecs")):
        return False
    if not (MIN_RAMP_FACTOR <= r["from"] <= MAX_RAMP_FACTOR
            and MIN_RAMP_FACTOR <= r["to"] <= MAX_RAMP_FACTOR
            and 0 < r["overSecs"] <= MAX_RAMP_OVER_SECS):
        return False
    ratio = float(r["to"]) / float(r["from"])
    return math.isfinite(ratio) and ratio > 0


def load_custom_patterns():
    """Custom patterns from ~/.config/omarchy/zen/patterns.json, validated the
    way ZenModel.js parseCustomPatterns validates them. Keys are lowercased; a
    key seen earlier in the file (even on a bad entry) blocks later ones; a key
    that collides with a built-in is ignored; a bad entry is skipped. A malformed
    file yields no custom patterns rather than an error."""
    path = os.path.expanduser("~/.config/omarchy/zen/patterns.json")
    out = {}
    try:
        with open(path) as f:
            data = json.load(f, parse_constant=_reject_json_constant)
    except (OSError, ValueError):
        return out
    entries = data.get("patterns") if isinstance(data, dict) else None
    if not isinstance(entries, list):
        return out
    seen = set()
    for p in entries:
        if not isinstance(p, dict) or not isinstance(p.get("key"), str):
            continue
        key = p["key"].lower()
        if not KEY_RE.fullmatch(key) or key in seen:
            continue
        seen.add(key)
        if key in BUILTIN:
            continue
        name = p.get("name")
        phases = p.get("phases")
        if not isinstance(name, str) or name == "":
            continue
        if not isinstance(phases, list) or len(phases) < 2:
            continue
        if not all(_valid_phase(ph) for ph in phases):
            continue
        entry = {
            "name": name,
            "phases": [(ph["label"], float(ph["secs"]), float(ph["to"])) for ph in phases],
        }
        ramp = p.get("ramp")
        if _valid_ramp(ramp):
            entry["ramp"] = {k: float(ramp[k]) for k in ("from", "to", "overSecs")}
        out[key] = entry
    return out


def resolve_pattern(key):
    """The pattern for key, as ZenModel.pattern resolves it: keys ignore case,
    custom patterns come from patterns.json, and an unknown key is box."""
    key = str(key or "").lower()
    custom = load_custom_patterns()
    if key in custom:
        return custom[key]
    return BUILTIN.get(key, BUILTIN["box"])


def ramp_scale(pat, t):
    """Port of ZenModel.js rampScale: the tempo multiplier t seconds into a
    session (1 with no ramp). It moves linearly from `from` to `to` over
    `overSecs`, then holds."""
    ramp = pat.get("ramp")
    if not ramp:
        return 1.0
    f = min(max(t / ramp["overSecs"], 0.0), 1.0)
    return ramp["from"] + (ramp["to"] - ramp["from"]) * f


def ramp_base_time(pat, t):
    """Port of ZenModel.js rampBaseTime: the written-pattern seconds that have
    passed after t real seconds, integrating 1/scale over the ramp."""
    t = max(t, 0.0)
    ramp = pat.get("ramp")
    if not ramp:
        return t
    r0, r1, over = ramp["from"], ramp["to"], ramp["overSecs"]
    if r1 == r0:
        return t / r0
    if t <= over:
        return over / (r1 - r0) * math.log((r0 + (r1 - r0) * t / over) / r0)
    done = over / (r1 - r0) * math.log(r1 / r0)
    return done + (t - over) / r1


def breath_at(pat, elapsed):
    """Port the overlay's phase timeline without its half-cosine fullness easing.
    The terminal renderer quantizes fullness to cells, so keeping its motion
    linear avoids a separate easing path while preserving phase timing and ramp
    speed. For elapsed real seconds, return (label, whole seconds left in the
    phase at the session's tempo, fullness in [0, 1]).
    """
    phases = pat["phases"]
    cycle = sum(ph[1] for ph in phases)
    into = ramp_base_time(pat, elapsed) % cycle
    scale = ramp_scale(pat, elapsed)
    frm = phases[-1][2]
    for label, secs, to in phases:
        if into < secs:
            return label, math.ceil((secs - into) * scale), frm + (to - frm) * (into / secs)
        into -= secs
        frm = to
    return phases[0][0], math.ceil(phases[0][1] * scale), frm


def fmt_clock(total_secs):
    total_secs = max(0, int(math.ceil(total_secs)))
    return "%d:%02d" % (total_secs // 60, total_secs % 60)


def circle_block(radius, max_radius, colour):
    """Render the breathing circle as a fixed-height block of lines.

    Always returns 2 * max_radius + 1 lines so the block height never
    changes as the circle grows and shrinks (which keeps the redraw
    stable). The circle is centred vertically in the block.
    """
    height = 2 * max_radius + 1
    half_w = int(max_radius * ASPECT)
    lines = []
    for row in range(height):
        y = row - max_radius
        line = ""
        for col in range(-half_w, half_w + 1):
            d = math.sqrt((col / ASPECT) ** 2 + y ** 2)
            if d <= radius - 0.6:
                line += "●"
            elif d <= radius:
                line += "○"
            else:
                line += " "
        lines.append(line.rstrip())
    # Colour the whole circle; the text lines are drawn uncoloured.
    coloured = ["\x1b[%sm%s%s" % (colour, ln, RESET) if ln.strip() else ln for ln in lines]
    return coloured


DEFAULT_MINUTES = 5
MAX_MINUTES = 120  # longest session the CLI accepts; bounds accidental runs


def parse_minutes(raw):
    """Return the session length in minutes for a CLI argument.

    raw is the argv string, or None when absent. Invalid and nonpositive
    values give DEFAULT_MINUTES; valid values above MAX_MINUTES are clamped
    to it, so arbitrarily large integers cannot start an enormous session.
    Non-integer text such as "2.5" counts as invalid.
    """
    try:
        minutes = int(raw)
    except (TypeError, ValueError):
        return DEFAULT_MINUTES
    if minutes <= 0:
        return DEFAULT_MINUTES
    return min(minutes, MAX_MINUTES)


def record_stats(args):
    """Entry point of `tb-guide --record-stats PATH DAY MINUTES`, the stats-only
    write the bar makes after a session. PATH must be absolute, DAY is YYYY-MM-DD
    and MINUTES is 1 to 999999; nothing is written for bad arguments.

    Returns 0 on success, 2 for bad arguments, and 1 when the file cannot be
    written (the error goes to stderr).
    """
    if (len(args) != 3 or not os.path.isabs(args[0]) or not DAY_RE.fullmatch(args[1])
            or not MINUTES_RE.fullmatch(args[2])):
        sys.stderr.write("usage: tb-guide --record-stats PATH YYYY-MM-DD MINUTES\n")
        return 2
    try:
        add_stats_minutes(args[0], args[1], int(args[2]))
    except OSError as e:
        sys.stderr.write("tb-guide: could not record stats: %s\n" % e)
        return 1
    return 0


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--record-stats":
        return record_stats(sys.argv[2:])
    pattern_key = sys.argv[1] if len(sys.argv) > 1 else "box"
    minutes = parse_minutes(sys.argv[2] if len(sys.argv) > 2 else None)

    pat = resolve_pattern(pattern_key)
    total_secs = minutes * 60

    # Size the circle to the terminal (narrow phone screens included).
    try:
        cols, rows = shutil.get_terminal_size()
    except OSError:
        cols, rows = 80, 24
    max_radius = max(3, min(9, (cols // 2 - 2) // 2, (rows - 8) // 2))
    max_radius = min(max_radius, 10)

    stop = {"flag": False}

    def on_sigint(signum, frame):
        stop["flag"] = True

    signal.signal(signal.SIGINT, on_sigint)

    circle_height = 2 * max_radius + 1
    text_lines = 3  # phase, countdown, hint
    block_lines = circle_height + text_lines

    sys.stdout.write("\x1b[?25l")  # hide cursor
    sys.stdout.flush()
    try:
        print("Terminal Breather — %s · %d min" % (pat["name"], minutes))
        print("Ctrl+C to end early. Sessions under a minute are not logged.")
        print()
        for _ in range(block_lines):
            print()

        start = time.monotonic()
        while True:
            elapsed = time.monotonic() - start
            remaining = total_secs - elapsed
            if remaining <= 0 or stop["flag"]:
                break
            label, phase_left, fullness = breath_at(pat, elapsed)
            radius = MIN_RADIUS + fullness * (max_radius - MIN_RADIUS)
            colour = PHASE_COLOURS.get(label, "36")

            lines = circle_block(radius, max_radius, colour)
            lines.append(label)
            lines.append("%d · %s left" % (phase_left, fmt_clock(remaining)))
            lines.append("")

            sys.stdout.write("\x1b[%dA" % block_lines)
            for ln in lines:
                sys.stdout.write("\r\x1b[K%s\n" % ln)
            sys.stdout.flush()
            time.sleep(0.08)
    finally:
        sys.stdout.write("\x1b[?25h")  # show cursor again
        sys.stdout.flush()

    elapsed = time.monotonic() - start
    completed = elapsed >= total_secs and not stop["flag"]
    logged = log_session(pat["name"], elapsed, total_secs, completed)
    print()
    if completed:
        if logged >= 1:
            print("Done — %s · %s. Logged %d min to your meditation log." % (
                pat["name"], fmt_clock(elapsed), logged))
        else:
            print("Done — %s · %s. Nice work." % (pat["name"], fmt_clock(elapsed)))
    else:
        if logged >= 1:
            print("Ended early after %s — logged %d min." % (
                fmt_clock(elapsed), logged))
        else:
            print("Ended early after %s (under a minute — not logged)." % fmt_clock(elapsed))
    return 0


if __name__ == "__main__":
    sys.exit(main())
