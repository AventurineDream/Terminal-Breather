#!/usr/bin/env python3
"""tb-guide — a terminal breathing guide for Terminal Breather.

Runs a breathing session right in the terminal (for use over SSH, e.g.
Termius on a phone, where the GUI overlay on the computer's displays is not
visible). Same patterns and timings as the luotao.zen plugin.

The guide draws a circle that grows as you breathe in, holds, and
shrinks as you breathe out — the same idea as the overlay's figure that
scales with the breath — with a colour that shifts by phase.

Sessions that reach at least one minute are logged exactly the way the
overlay logs them: minutes added to today's entry in
~/.local/state/omarchy/zen/stats.json, and one row appended to the
meditation log (the vault default, or meditationLogPath from shell.json
when set). Ending early still logs the minutes actually practiced.
Sessions under a minute are not logged.

Usage: tb-guide [pattern] [minutes]
  pattern  box (default), 478, coherent, or a custom key from
           ~/.config/omarchy/zen/patterns.json
  minutes  session length (default 5, max 120)

Ctrl+C ends the session early.
"""

import json
import math
import os
import re
import shutil
import signal
import sys
import time
from datetime import datetime

# Built-in patterns, mirroring ZenModel.js PATTERNS.
# Each phase: (label, seconds, fullness at end) — fullness 0 = exhaled,
# 1 = inhaled. The circle grows toward 1 on inhale and shrinks toward 0
# on exhale; a hold keeps the current fullness.
BUILTIN = {
    "box": {
        "name": "Box breathing",
        "phases": [
            ("Breathe in", 4, 1),
            ("Hold", 4, 1),
            ("Breathe out", 4, 0),
            ("Hold", 4, 0),
        ],
    },
    "478": {
        "name": "4-7-8",
        "phases": [
            ("Breathe in", 4, 1),
            ("Hold", 7, 1),
            ("Breathe out", 8, 0),
        ],
    },
    "coherent": {
        "name": "Coherent",
        "phases": [
            ("Breathe in", 5.5, 1),
            ("Breathe out", 5.5, 0),
        ],
    },
}

# ANSI colours per phase (by the first word of the label).
PHASE_COLOURS = {
    "Breathe in": "36",   # cyan
    "Hold": "33",         # amber
    "Breathe out": "35",  # magenta
}
RESET = "\x1b[0m"

# Terminal characters are about twice as tall as they are wide, so a
# circle drawn in character cells needs the x axis stretched.
ASPECT = 2.0
MIN_RADIUS = 1.5

# ---- Session logging, mirroring ZenModel.js / BreatheOverlay.qml ----
# Stats are stored as {"days": {"2026-08-22": 10, ...}} minutes.
STATS_PATH = os.path.expanduser("~/.local/state/omarchy/zen/stats.json")
MEDITATION_LOG_HEADER = (
    "# Meditation Log\n"
    "\n"
    "Sessions logged by Terminal-Breather (fork of luotao.zen) — one row per session, appended automatically when a session ends.\n"
    "\n"
    "| Date | Pattern | Minutes | Completed |\n"
    "| --- | --- | --- | --- |"
)


def default_log_path(home):
    """The vault default meditation log, mirroring meditationLogPath()."""
    return (home or "") + "/Projects/Obsidian/Home/20_Practices/Meditation/Meditation Log.md"


def normalize_log_path(raw, home):
    """Port of ZenModel.js normalizeLogPath: the absolute path to save,
    "" for "use the vault default", or None when the input is not a
    usable path (whitespace-only, relative, or a bare ~ with no home)."""
    text = "" if raw is None else str(raw)
    if text == "":
        return ""
    trimmed = text.strip()
    if trimmed == "":
        return None
    expanded = trimmed
    if expanded == "~":
        if not home:
            return None
        expanded = str(home)
    elif expanded.startswith("~/"):
        if not home:
            return None
        expanded = str(home) + expanded[1:]
    if not expanded.startswith("/"):
        return None
    return expanded


def _reject_json_constant(name):
    """json parse_constant hook: NaN, Infinity and -Infinity are not JSON.
    ZenModel.js's JSON.parse rejects them, so the guide treats them as
    malformed input too, or it would read a file the overlay ignores."""
    raise ValueError("non-standard JSON constant: " + name)


def resolve_log_path():
    """The meditation-log path for this session: the meditationLogPath
    setting from shell.json (normalised), or the vault default. An
    invalid setting falls back to the default, the way the panel's
    validation would never save it in the first place."""
    home = os.path.expanduser("~")
    setting = ""
    try:
        with open(os.path.expanduser("~/.config/omarchy/shell.json")) as f:
            data = json.load(f, parse_constant=_reject_json_constant)
        setting = _find_luotaozen_setting(data, "meditationLogPath", "")
    except (OSError, ValueError):
        setting = ""
    normalized = normalize_log_path(setting, home)
    if normalized is None or normalized == "":
        return default_log_path(home)
    return normalized


def _find_luotaozen_setting(data, key, fallback):
    """Walk shell.json and return key from the luotao.zen bar entry."""
    if isinstance(data, dict):
        if data.get("id") == "luotao.zen" and key in data:
            return data[key]
        for value in data.values():
            found = _find_luotaozen_setting(value, key, None)
            if found is not None:
                return found
    elif isinstance(data, list):
        for value in data:
            found = _find_luotaozen_setting(value, key, None)
            if found is not None:
                return found
    return fallback


def parse_stats(raw):
    """Port of ZenModel.js parseStats: {"days": {...}} or {} on bad input."""
    try:
        parsed = json.loads(raw or "{}", parse_constant=_reject_json_constant)
        if parsed and isinstance(parsed.get("days"), dict):
            return {"days": parsed["days"]}
    except (ValueError, TypeError):
        pass
    return {"days": {}}


def add_minutes(stats, day_key, minutes):
    """Port of ZenModel.js addMinutes: minutes are rounded when added."""
    days = dict(stats.get("days", {}))
    days[day_key] = round((days.get(day_key) or 0) + minutes)
    return {"days": days}


def log_row(date_key, pattern_name, minutes, completed):
    """Port of ZenModel.js logRow. Pattern names are scrubbed so pipes
    and newlines can never break the table or the line."""
    name = re.sub(r"[|\r\n]", " ", str(pattern_name or ""))
    name = re.sub(r"\s+", " ", name).strip()
    if not name:
        name = "Unknown"
    return "| %s | %s | %d | %s |" % (
        date_key, name, int(minutes) if minutes else 0,
        "yes" if completed else "no")


def log_session(pattern_name, elapsed_secs, total_secs, completed):
    """Log a finished session the way BreatheOverlay.endSession does.

    minutes is floor(elapsed / 60) when ended early, or max(1,
    round(total / 60)) when completed. Nothing is logged under one
    minute. Stats get mkdir -p and a full rewrite; the meditation log
    is created with the header when missing, and skipped silently when
    its folder is gone (no mkdir — the row never lands somewhere the
    vault is not). Returns the minutes logged, or 0 when nothing was.
    """
    if completed:
        minutes = max(1, round(total_secs / 60))
    else:
        minutes = int(elapsed_secs // 60)
    if minutes < 1:
        return 0

    today = datetime.now().strftime("%Y-%m-%d")

    # Stats: read, add, write back (mkdir -p first, like
    # persistStatsCommand).
    try:
        with open(STATS_PATH) as f:
            stats = parse_stats(f.read())
    except OSError:
        stats = {"days": {}}
    stats = add_minutes(stats, today, minutes)
    try:
        os.makedirs(os.path.dirname(STATS_PATH), exist_ok=True)
        with open(STATS_PATH, "w") as f:
            json.dump(stats, f)
    except OSError:
        pass

    # Meditation log: create with the header when missing, then append
    # the row. Skip silently when the folder is gone.
    log_path = resolve_log_path()
    try:
        if not os.path.isdir(os.path.dirname(log_path)):
            return minutes
        row = log_row(today, pattern_name, minutes, completed)
        if not os.path.isfile(log_path):
            with open(log_path, "w") as f:
                f.write(MEDITATION_LOG_HEADER + "\n")
        with open(log_path, "a") as f:
            f.write(row + "\n")
    except OSError:
        pass
    return minutes


# Custom-pattern validation and phase timing mirror ZenModel.js. Fullness
# motion is linear here, unlike the eased overlay (see breath_at).
KEY_RE = re.compile(r"[a-z0-9][a-z0-9-]*")


def _is_num(v):
    """A JSON number. bool is excluded: True is not a number of seconds."""
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def _finite(v):
    """True for a finite JSON number. A JSON integer with hundreds of digits is
    valid JSON but overflows float(); it counts as not finite, as JS Number()
    makes such a literal Infinity in ZenModel.js."""
    try:
        return math.isfinite(v)
    except OverflowError:
        return False


# Limits on custom-pattern numbers, mirrored in ZenModel.js. Built-in patterns
# use short phases without ramps; the example Breath of Fire ramps from 2 to 0.5.
# These bounds keep `secs * scale` finite before math.ceil; over-limit phases
# are skipped and an invalid ramp is dropped while keeping its pattern.
MAX_PHASE_SECS = 3600.0
MAX_RAMP_OVER_SECS = 3600.0
MIN_RAMP_FACTOR = 0.01
MAX_RAMP_FACTOR = 100.0


def _valid_phase(ph):
    """Port of ZenModel.js isValidPhase: a label, secs above 0 and at most
    MAX_PHASE_SECS, and a target fullness of exactly 0 or 1."""
    return (isinstance(ph, dict) and isinstance(ph.get("label"), str)
            and ph["label"] != "" and _is_num(ph.get("secs"))
            and _finite(ph["secs"]) and 0 < ph["secs"] <= MAX_PHASE_SECS
            and _is_num(ph.get("to")) and ph["to"] in (0, 1))


def _valid_ramp(r):
    """Port of ZenModel.js validRamp: from and to are finite factors within
    [MIN_RAMP_FACTOR, MAX_RAMP_FACTOR]; overSecs is finite, above 0 and at
    most MAX_RAMP_OVER_SECS; and to/from is a finite positive ratio. A ratio
    that underflows to 0 or overflows to inf would make ramp_base_time take
    log(0) or return inf mid-session."""
    if not isinstance(r, dict):
        return False
    if not all(_is_num(r.get(k)) and _finite(r[k]) for k in ("from", "to", "overSecs")):
        return False
    if not (MIN_RAMP_FACTOR <= r["from"] <= MAX_RAMP_FACTOR
            and MIN_RAMP_FACTOR <= r["to"] <= MAX_RAMP_FACTOR
            and 0 < r["overSecs"] <= MAX_RAMP_OVER_SECS):
        return False
    ratio = float(r["to"]) / float(r["from"])
    return math.isfinite(ratio) and ratio > 0


def load_custom_patterns():
    """Custom patterns from ~/.config/omarchy/zen/patterns.json, validated the
    way ZenModel.js parseCustomPatterns validates them. Keys are lowercased; a
    key seen earlier in the file (even on a bad entry) blocks later ones; a key
    that collides with a built-in is ignored; a bad entry is skipped. A malformed
    file yields no custom patterns rather than an error."""
    path = os.path.expanduser("~/.config/omarchy/zen/patterns.json")
    out = {}
    try:
        with open(path) as f:
            data = json.load(f, parse_constant=_reject_json_constant)
    except (OSError, ValueError):
        return out
    entries = data.get("patterns") if isinstance(data, dict) else None
    if not isinstance(entries, list):
        return out
    seen = set()
    for p in entries:
        if not isinstance(p, dict) or not isinstance(p.get("key"), str):
            continue
        key = p["key"].lower()
        if not KEY_RE.fullmatch(key) or key in seen:
            continue
        seen.add(key)
        if key in BUILTIN:
            continue
        name = p.get("name")
        phases = p.get("phases")
        if not isinstance(name, str) or name == "":
            continue
        if not isinstance(phases, list) or len(phases) < 2:
            continue
        if not all(_valid_phase(ph) for ph in phases):
            continue
        entry = {
            "name": name,
            "phases": [(ph["label"], float(ph["secs"]), float(ph["to"])) for ph in phases],
        }
        ramp = p.get("ramp")
        if _valid_ramp(ramp):
            entry["ramp"] = {k: float(ramp[k]) for k in ("from", "to", "overSecs")}
        out[key] = entry
    return out


def resolve_pattern(key):
    """The pattern for key, as ZenModel.pattern resolves it: keys ignore case,
    custom patterns come from patterns.json, and an unknown key is box."""
    key = str(key or "").lower()
    custom = load_custom_patterns()
    if key in custom:
        return custom[key]
    return BUILTIN.get(key, BUILTIN["box"])


def ramp_scale(pat, t):
    """Port of ZenModel.js rampScale: the tempo multiplier t seconds into a
    session (1 with no ramp). It moves linearly from `from` to `to` over
    `overSecs`, then holds."""
    ramp = pat.get("ramp")
    if not ramp:
        return 1.0
    f = min(max(t / ramp["overSecs"], 0.0), 1.0)
    return ramp["from"] + (ramp["to"] - ramp["from"]) * f


def ramp_base_time(pat, t):
    """Port of ZenModel.js rampBaseTime: the written-pattern seconds that have
    passed after t real seconds, integrating 1/scale over the ramp."""
    t = max(t, 0.0)
    ramp = pat.get("ramp")
    if not ramp:
        return t
    r0, r1, over = ramp["from"], ramp["to"], ramp["overSecs"]
    if r1 == r0:
        return t / r0
    if t <= over:
        return over / (r1 - r0) * math.log((r0 + (r1 - r0) * t / over) / r0)
    done = over / (r1 - r0) * math.log(r1 / r0)
    return done + (t - over) / r1


def breath_at(pat, elapsed):
    """Port the overlay's phase timeline without its half-cosine fullness easing.
    The terminal renderer quantizes fullness to cells, so keeping its motion
    linear avoids a separate easing path while preserving phase timing and ramp
    speed. For elapsed real seconds, return (label, whole seconds left in the
    phase at the session's tempo, fullness in [0, 1]).
    """
    phases = pat["phases"]
    cycle = sum(ph[1] for ph in phases)
    into = ramp_base_time(pat, elapsed) % cycle
    scale = ramp_scale(pat, elapsed)
    frm = phases[-1][2]
    for label, secs, to in phases:
        if into < secs:
            return label, math.ceil((secs - into) * scale), frm + (to - frm) * (into / secs)
        into -= secs
        frm = to
    return phases[0][0], math.ceil(phases[0][1] * scale), frm


def fmt_clock(total_secs):
    total_secs = max(0, int(math.ceil(total_secs)))
    return "%d:%02d" % (total_secs // 60, total_secs % 60)


def circle_block(radius, max_radius, colour):
    """Render the breathing circle as a fixed-height block of lines.

    Always returns 2 * max_radius + 1 lines so the block height never
    changes as the circle grows and shrinks (which keeps the redraw
    stable). The circle is centred vertically in the block.
    """
    height = 2 * max_radius + 1
    half_w = int(max_radius * ASPECT)
    lines = []
    for row in range(height):
        y = row - max_radius
        line = ""
        for col in range(-half_w, half_w + 1):
            d = math.sqrt((col / ASPECT) ** 2 + y ** 2)
            if d <= radius - 0.6:
                line += "●"
            elif d <= radius:
                line += "○"
            else:
                line += " "
        lines.append(line.rstrip())
    # Colour the whole circle; the text lines are drawn uncoloured.
    coloured = ["\x1b[%sm%s%s" % (colour, ln, RESET) if ln.strip() else ln for ln in lines]
    return coloured


DEFAULT_MINUTES = 5
MAX_MINUTES = 120  # longest session the CLI accepts; bounds accidental runs


def parse_minutes(raw):
    """Return the session length in minutes for a CLI argument.

    raw is the argv string, or None when absent. Invalid and nonpositive
    values give DEFAULT_MINUTES; valid values above MAX_MINUTES are clamped
    to it, so arbitrarily large integers cannot start an enormous session.
    Non-integer text such as "2.5" counts as invalid.
    """
    try:
        minutes = int(raw)
    except (TypeError, ValueError):
        return DEFAULT_MINUTES
    if minutes <= 0:
        return DEFAULT_MINUTES
    return min(minutes, MAX_MINUTES)


def main():
    pattern_key = sys.argv[1] if len(sys.argv) > 1 else "box"
    minutes = parse_minutes(sys.argv[2] if len(sys.argv) > 2 else None)

    pat = resolve_pattern(pattern_key)
    total_secs = minutes * 60

    # Size the circle to the terminal (narrow phone screens included).
    try:
        cols, rows = shutil.get_terminal_size()
    except OSError:
        cols, rows = 80, 24
    max_radius = max(3, min(9, (cols // 2 - 2) // 2, (rows - 8) // 2))
    max_radius = min(max_radius, 10)

    stop = {"flag": False}

    def on_sigint(signum, frame):
        stop["flag"] = True

    signal.signal(signal.SIGINT, on_sigint)

    circle_height = 2 * max_radius + 1
    text_lines = 3  # phase, countdown, hint
    block_lines = circle_height + text_lines

    sys.stdout.write("\x1b[?25l")  # hide cursor
    sys.stdout.flush()
    try:
        print("Terminal Breather — %s · %d min" % (pat["name"], minutes))
        print("Ctrl+C to end early. Sessions under a minute are not logged.")
        print()
        for _ in range(block_lines):
            print()

        start = time.monotonic()
        while True:
            elapsed = time.monotonic() - start
            remaining = total_secs - elapsed
            if remaining <= 0 or stop["flag"]:
                break
            label, phase_left, fullness = breath_at(pat, elapsed)
            radius = MIN_RADIUS + fullness * (max_radius - MIN_RADIUS)
            colour = PHASE_COLOURS.get(label, "36")

            lines = circle_block(radius, max_radius, colour)
            lines.append(label)
            lines.append("%d · %s left" % (phase_left, fmt_clock(remaining)))
            lines.append("")

            sys.stdout.write("\x1b[%dA" % block_lines)
            for ln in lines:
                sys.stdout.write("\r\x1b[K%s\n" % ln)
            sys.stdout.flush()
            time.sleep(0.08)
    finally:
        sys.stdout.write("\x1b[?25h")  # show cursor again
        sys.stdout.flush()

    elapsed = time.monotonic() - start
    completed = elapsed >= total_secs and not stop["flag"]
    logged = log_session(pat["name"], elapsed, total_secs, completed)
    print()
    if completed:
        if logged >= 1:
            print("Done — %s · %s. Logged %d min to your meditation log." % (
                pat["name"], fmt_clock(elapsed), logged))
        else:
            print("Done — %s · %s. Nice work." % (pat["name"], fmt_clock(elapsed)))
    else:
        if logged >= 1:
            print("Ended early after %s — logged %d min." % (
                fmt_clock(elapsed), logged))
        else:
            print("Ended early after %s (under a minute — not logged)." % fmt_clock(elapsed))
    return 0


if __name__ == "__main__":
    sys.exit(main())
